{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning",
        "Unifi.IpManager": "Debug"
      }
    }
  },
  "Telemetry": {
    "ActivitySourceName": "Unifi.IpManager.Local.Activity",
    "Log": {
      "Type": "none"
    },
    "MeterName": "Unifi.IpManager.Local.Meter",
    "Metrics": {
      "Type": "console"
    },
    "ServiceName": "Unifi.IpManager.Local",
    "Trace": {
      "Type": "console"
    }
  }
}
