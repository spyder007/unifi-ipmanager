    <PackageVersion Include="Flurl.Http" Version="4.0.2" />
    <PackageVersion Include="NSwag.AspNetCore" Version="14.8.0" />
    <PackageVersion Include="NSwag.MSBuild" Version="14.8.0" />
    <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.36.0.15337" />
    <PackageVersion Include="Spydersoft.Platform.Hosting" Version="3.1.0" />
    
    <!-- Test Project Packages -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.2" />
    <PackageVersion Include="Moq" Version="4.21.0" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
